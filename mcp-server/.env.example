# Copy this file to .env and fill in real values. Never commit .env.
#
# Same project as VITE_SUPABASE_URL in the root .env, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Supabase dashboard -> Project Settings -> API -> "service_role" secret key.
# This key BYPASSES Row Level Security. Keep it out of git and out of the
# website bundle - it must only ever be used by this standalone server process.
SUPABASE_SERVICE_ROLE_KEY=
